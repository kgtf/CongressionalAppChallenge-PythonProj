    m_Metadata:
      m_Items: []
  - m_Id: 2130788823047
    m_Localized: "\u0425\u043E\u043B\u043E\u0434\u043D\u044B\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 2130793017344
    m_Localized: "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0441\u0432\u043E\u0438
      \u043F\u0440\u0435\u0434\u043F\u043E\u0447\u0442\u0435\u043D\u0438\u044F \u043D\u0438\u0436\u0435,
      \u0447\u0442\u043E\u0431\u044B \u043D\u0430\u0439\u0442\u0438 \u043B\u0443\u0447\u0448\u0438\u0435
      \u0441\u0442\u0440\u0430\u043D\u044B \u0434\u043B\u044F \u043F\u0435\u0440\u0435\u0441\u0435\u043B\u0435\u043D\u0438\u044F
      \u0441 \u0443\u0447\u0435\u0442\u043E\u043C \u043A\u043B\u0438\u043C\u0430\u0442\u0430,
      \u043A\u0443\u043B\u044C\u0442\u0443\u0440\u044B, \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u0438
      \u0436\u0438\u0437\u043D\u0438 \u0438 \u0434\u0440\u0443\u0433\u0438\u0445
      \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A."
    m_Metadata:
      m_Items: []
